rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function staff(){return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','teacher'];}
  match /users/{uid} {
   allow create: if signedIn() && request.auth.uid == uid;
   allow read: if signedIn() && (request.auth.uid == uid || staff());
   allow update: if signedIn() && (request.auth.uid == uid || staff());
  }
  match /classes/{id} {allow read: if true; allow create,update,delete: if staff();}
  match /materials/{id} {allow read: if true; allow create,update,delete: if staff();}
  match /exams/{id} {allow read: if signedIn(); allow create,update,delete: if staff();}
  match /results/{id} {
   allow create: if signedIn() && request.resource.data.student == request.auth.uid;
   allow read: if signedIn() && (resource.data.student == request.auth.uid || staff());
   allow update,delete: if staff();
  }
 }
}